# Google OAuth2 Credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Heimdall Application Configuration
HEIMDALL_FRONTEND_URL=http://localhost:5173
HEIMDALL_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HEIMDALL_ADMIN_EMAIL=admin@example.com
HEIMDALL_ALLOWED_DOMAINS=example.com
HEIMDALL_SECRET_KEY=ThisIsADefaultSecretKeyForDevEnv

# Storage & S3 / SeaweedFS Configuration
HEIMDALL_STORAGE_TYPE=s3
HEIMDALL_S3_ENDPOINT=http://localhost:8333
HEIMDALL_S3_REGION=us-east-1
HEIMDALL_S3_BUCKET_NAME=heimdall-backups
HEIMDALL_S3_ACCESS_KEY=dummy-access-key
HEIMDALL_S3_SECRET_KEY=dummy-secret-key
HEIMDALL_S3_PATH_STYLE_ACCESS=true
HEIMDALL_S3_AUTO_CREATE_BUCKET=true

flowchart TD
    subgraph Frontend["React Frontend (Vite + TS)"]
        UI["UI Pages & Components"]
        AuthCtx["Auth Context (JWT)"]
        Axios["Axios Client"]
    end

    subgraph Backend["Spring Boot Backend"]
        Security["Spring Security (OAuth2 / OIDC / JWT Filter)"]
        CORS["CORS Configuration (Dynamic Origins)"]
        OAuthHandler["TokenAuthSuccessHandler (Redirect to Frontend URL)"]
        
        subgraph Controllers["REST Controllers"]
            AuthController["AuthController (/api/auth)"]
            TargetDbController["TargetDatabaseController (/api/databases)"]
            SnapshotController["SnapshotController (/api/snapshots)"]
        end

        subgraph Services["Service Layer"]
            UserService["CustomOAuth2UserService / CustomOidcUserService"]
            JwtService["JwtService"]
            BackupScheduler["Quartz Scheduler (BackupJob)"]
            RestorationService["RestorationService"]
            CleanupService["SnapshotCleanupService"]
            StorageService["StorageService (S3StorageService / LocalStorageService)"]
        end

        subgraph Storage["Internal Data"]
            H2DB[("H2 Config Database")]
        end
    end

    subgraph External["External Services & Storage"]
        GoogleOAuth["Google Identity Provider"]
        TargetPostgres[("Target PostgreSQL Databases")]
        S3Storage[("S3 Object Storage (AWS S3 / SeaweedFS)")]
        LocalDumps[("Local FS Dumps (Fallback)")]
    end

    %% Flow interactions
    UI -->|1. Sign in with Google| Security
    Security -->|2. Delegate Auth| GoogleOAuth
    GoogleOAuth -->|3. OAuth2 Code & Claims| UserService
    UserService -->|4. User Role Mapping & Sync| H2DB
    Security -->|5. On Success| OAuthHandler
    OAuthHandler -->|6. Redirect with JWT (?token=)| UI
    UI -->|7. API Requests with Bearer JWT| Axios
    Axios -->|8. HTTP Requests| CORS
    CORS --> Security
    Security --> Controllers

    Controllers --> Services
    BackupScheduler -->|Execute pg_dump| TargetPostgres
    BackupScheduler -->|Upload Snapshot| StorageService
    RestorationService -->|Download Snapshot| StorageService
    RestorationService -->|Execute pg_restore| TargetPostgres
    CleanupService -->|Purge Expired Snapshots| StorageService
    StorageService -->|S3 API| S3Storage
    StorageService -.->|Local FS| LocalDumps
